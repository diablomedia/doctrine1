{
    "name": "diablomedia/doctrine1",
    "type": "library",
    "description": "PHP5+ Database ORM",
    "keywords": [
        "orm",
        "database"
    ],
    "homepage": "http://www.doctrine-project.org",
    "license": "LGPL-2.1-or-later",
    "authors": [
        {
            "name": "Konsta Vesterinen",
            "email": "kvesteri@cc.hut.fi"
        },
        {
            "name": "Jonathan Wage",
            "email": "jonwage@gmail.com"
        }
    ],
    "autoload": {
        "psr-0": {
            "Doctrine_": "lib/"
        },
        "classmap": [
            "lib/Doctrine.php"
        ]
    },
    "replace": {
        "doctrine/doctrine1": "*"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-pdo": "*",
        "symfony/yaml": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "amphp/amp": "^3.1.3",
        "amphp/cache": "^2.0.1",
        "amphp/dns": "^2.4.1",
        "amphp/parallel": "^2.4.0",
        "amphp/parser": "^1.1.1",
        "amphp/process": "^2.1.0",
        "amphp/socket": "^2.4.1",
        "daverandom/libdns": "^2.1.0",
        "phpunit/php-code-coverage": "^9.2.32",
        "revolt/event-loop": "^1.0.9",
        "spatie/array-to-xml": "^3.4.4",
        "friendsofphp/php-cs-fixer": "^3.95.23",
        "nikic/php-parser": "^5.8.0",
        "phpstan/phpstan": "2.2.8",
        "vimeo/psalm": "^6.16.1"
    },
    "scripts": {
        "test": "cd tests && php run.php",
        "test-with-coverage": "cd tests && php run.php --coverage=clover",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=768M",
        "psalm": "psalm --show-info=false",
        "static-analysis": [
            "@phpstan",
            "@psalm"
        ],
        "style-check": "php-cs-fixer fix --dry-run -vv"
    }
}
